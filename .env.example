NODE_ENV=development
PORT=3000

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=ur-pusgre

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=ur-pusgre-direct-url

# Auth (JWT) generate with "openssl rand -hex 48"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Seed: akun SYS_ADMIN
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_EMAIL=admin@kerjaindong.local
SEED_ADMIN_PASSWORD=SuperAdmin123
