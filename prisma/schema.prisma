generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ======================================================
// 1. BOUNDED CONTEXT: IDENTITY & ACCESS (IAM)
// ======================================================

enum Role {
  JOB_SEEKER
  EMPLOYER
  SYS_ADMIN
}

model User {
  id          String    @id @default(uuid(7)) @db.Uuid
  email       String    @unique @db.VarChar(255) // simpan lowercase
  username    String    @unique @db.VarChar(50) // simpan lowercase
  password    String    @db.VarChar(255) // argon2id hash
  fullName    String?   @map("full_name") @db.VarChar(150)
  avatarKey   String?   @map("avatar_key") @db.VarChar(512)
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                 UserSession[]
  roles                    UserRoleAssignment[]
  jobSeekerProfile         JobSeekerProfile?
  employerProfile          EmployerProfile?
  auditLogs                AuditLog[]               @relation("AuditActor")
  invitationsSent          CompanyInvitation[]      @relation("InvitedBy")
  applicationStatusChanges ApplicationStatusHistory[]

  @@map("users")
}

model UserSession {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String    @map("hashed_token") @db.VarChar(255)
  userAgent   String?   @map("user_agent") @db.VarChar(500)
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastActive  DateTime  @default(now()) @map("last_active") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserRoleAssignment {
  userId      String   @map("user_id") @db.Uuid
  role        Role
  grantedById String?  @map("granted_by_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

// ======================================================
// 2. BOUNDED CONTEXT: SEEKER DOMAIN
// ======================================================

model JobSeekerProfile {
  id         String  @id @default(uuid(7)) @db.Uuid
  userId     String  @unique @map("user_id") @db.Uuid
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String  @map("first_name") @db.VarChar(100)
  lastName   String? @map("last_name") @db.VarChar(100)
  headline   String? @db.VarChar(255)
  summary    String?
  phone      String? @db.VarChar(30)
  photoKey   String? @map("photo_key") @db.VarChar(512)
  provinceId String? @map("province_id") @db.Uuid
  cityId     String? @map("city_id") @db.Uuid
  expectedSalary Int?    @map("expected_salary")
  salaryCurrency String  @default("IDR") @map("salary_currency") @db.VarChar(3)
  openToWork     Boolean @default(true) @map("open_to_work")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  resumes           Resume[]
  applications      JobApplication[]
  savedJobs         SavedJob[]
  followedCompanies CompanyFollow[]

  @@index([cityId])
  @@index([openToWork])
  @@map("job_seeker_profiles")
}

model Resume {
  id          String           @id @default(uuid(7)) @db.Uuid
  jobSeekerId String           @map("job_seeker_id") @db.Uuid
  jobSeeker   JobSeekerProfile @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  title       String           @db.VarChar(150)
  isPrimary   Boolean          @default(false) @map("is_primary")
  summary     String?
  fileKey     String?          @map("file_key") @db.VarChar(512)
  // Fase berikutnya: Experience, Education, ResumeSkill, Certification, Project, Language
  applications JobApplication[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([jobSeekerId, isPrimary])
  @@map("resumes")
}

// ======================================================
// 3. BOUNDED CONTEXT: COMPANY & EMPLOYER DOMAIN
// ======================================================

enum CompanyMemberRole {
  OWNER
  ADMIN
  RECRUITER
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model Company {
  id           String             @id @default(uuid(7)) @db.Uuid
  name         String             @db.VarChar(255) // tidak unique: nama badan hukum bisa sama
  slug         String             @unique @db.VarChar(255)
  logoKey      String?            @map("logo_key") @db.VarChar(512)
  bannerKey    String?            @map("banner_key") @db.VarChar(512)
  website      String?            @db.VarChar(255)
  industry     String?            @db.VarChar(100)
  description  String?
  provinceId   String?            @map("province_id") @db.Uuid
  cityId       String?            @map("city_id") @db.Uuid
  verification VerificationStatus @default(UNVERIFIED)
  verifiedAt   DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  employers   EmployerProfile[]
  jobPosts    JobPost[]
  follows     CompanyFollow[]
  invitations CompanyInvitation[]

  @@index([cityId])
  @@index([verification])
  @@map("companies")
}

model EmployerProfile {
  id          String            @id @default(uuid(7)) @db.Uuid
  userId      String            @unique @map("user_id") @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String            @map("company_id") @db.Uuid
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  firstName   String            @map("first_name") @db.VarChar(100)
  lastName    String?           @map("last_name") @db.VarChar(100)
  position    String?           @db.VarChar(100)
  companyRole CompanyMemberRole @default(RECRUITER) @map("company_role")
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, companyRole])
  @@map("employer_profiles")
}

model CompanyInvitation {
  id          String            @id @default(uuid(7)) @db.Uuid
  companyId   String            @map("company_id") @db.Uuid
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String            @db.VarChar(255)
  role        CompanyMemberRole @default(RECRUITER)
  tokenHash   String            @unique @map("token_hash") @db.VarChar(255)
  invitedById String?           @map("invited_by_id") @db.Uuid
  invitedBy   User?             @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?         @map("accepted_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId])
  @@index([email])
  @@map("company_invitations")
}

// ======================================================
// 4. REFERENCE: WILAYAH INDONESIA
// ======================================================

enum RegionLevel {
  PROVINCE
  REGENCY
  DISTRICT
  VILLAGE
}

model Region {
  id       String      @id @default(uuid(7)) @db.Uuid
  code     String      @unique @db.VarChar(20) // kode BPS
  name     String      @db.VarChar(150)
  level    RegionLevel
  parentId String?     @map("parent_id") @db.Uuid
  parent   Region?     @relation("RegionTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Region[]    @relation("RegionTree")

  @@index([level, parentId])
  @@index([name])
  @@map("regions")
}

// ======================================================
// 5. BOUNDED CONTEXT: JOB & APPLICATION DOMAIN
// ======================================================

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum SalaryPeriod {
  HOURLY
  DAILY
  MONTHLY
  YEARLY
}

model JobPost {
  id              String          @id @default(uuid(7)) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  title           String          @db.VarChar(255)
  slug            String          @unique @db.VarChar(255)
  description     String
  requirements    String?
  benefits        String?
  employmentType  EmploymentType  @map("employment_type")
  workMode        WorkMode        @default(ONSITE) @map("work_mode")
  experienceLevel ExperienceLevel? @map("experience_level")
  provinceId      String?         @map("province_id") @db.Uuid
  cityId          String?         @map("city_id") @db.Uuid
  salaryMin       Int?            @map("salary_min")
  salaryMax       Int?            @map("salary_max")
  salaryCurrency  String          @default("IDR") @map("salary_currency") @db.VarChar(3)
  salaryPeriod    SalaryPeriod    @default(MONTHLY) @map("salary_period")
  status          JobStatus       @default(DRAFT)
  publishedAt     DateTime?       @map("published_at") @db.Timestamptz(3)
  expiresAt       DateTime?       @map("expires_at") @db.Timestamptz(3)
  closedAt        DateTime?       @map("closed_at") @db.Timestamptz(3)
  viewCount       Int             @default(0) @map("view_count")
  applicationCount Int             @default(0) @map("application_count")
  applications    JobApplication[]
  savedJobs       SavedJob[]
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, publishedAt(sort: Desc)])
  @@index([companyId, status])
  @@index([status, cityId])
  @@index([status, employmentType])
  @@map("job_posts")
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  REJECTED
  ACCEPTED
  WITHDRAWN
}

model JobApplication {
  id          String           @id @default(uuid(7)) @db.Uuid
  jobPostId   String           @map("job_post_id") @db.Uuid
  jobPost     JobPost          @relation(fields: [jobPostId], references: [id], onDelete: Restrict)
  jobSeekerId String           @map("job_seeker_id") @db.Uuid
  jobSeeker   JobSeekerProfile @relation(fields: [jobSeekerId], references: [id], onDelete: Restrict)
  resumeId    String?          @map("resume_id") @db.Uuid
  resume      Resume?          @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  status          ApplicationStatus @default(APPLIED)
  resumeSnapshot  Json?             @map("resume_snapshot") // kondisi resume saat melamar
  coverLetter     String?             @map("cover_letter")
  viewedAt        DateTime?         @map("viewed_at") @db.Timestamptz(3)
  statusChangedAt DateTime?         @map("status_changed_at") @db.Timestamptz(3)
  history         ApplicationStatusHistory[]
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([jobPostId, jobSeekerId]) // tidak bisa melamar 2x di lowongan yang sama
  @@index([jobPostId, status])
  @@index([jobSeekerId, status, createdAt(sort: Desc)])
  @@map("job_applications")
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid(7)) @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  application   JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  changedById   String?           @map("changed_by_id") @db.Uuid
  changedBy     User?             @relation(fields: [changedById], references: [id], onDelete: SetNull)
  note          String?           @db.VarChar(500)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([applicationId, createdAt])
  @@map("application_status_history")
}

// ======================================================
// 6. BOUNDED CONTEXT: ENGAGEMENT & ADMIN
// ======================================================

model SavedJob {
  jobSeekerId String           @map("job_seeker_id") @db.Uuid
  jobSeeker   JobSeekerProfile @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  jobPostId   String           @map("job_post_id") @db.Uuid
  jobPost     JobPost          @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([jobSeekerId, jobPostId])
  @@index([jobPostId])
  @@map("saved_jobs")
}

model CompanyFollow {
  jobSeekerId String           @map("job_seeker_id") @db.Uuid
  jobSeeker   JobSeekerProfile @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  companyId   String           @map("company_id") @db.Uuid
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([jobSeekerId, companyId])
  @@index([companyId])
  @@map("company_follows")
}

model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String   @db.VarChar(100) // "company.verify", "job.archive", dst.
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  ip          String?  @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
